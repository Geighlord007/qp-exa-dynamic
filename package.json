{
  "name": "dsh-web-search-exa-dynamic",
  "version": "0.1.0",
  "description": "Exa web search provider for the DeepSeek Harness ctx.web seam, with Dynamic Highlights on by default and a /exa command to change them at runtime.",
  "license": "MIT",
  "author": "Geighlord007",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
