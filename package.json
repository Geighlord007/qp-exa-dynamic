  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "exa",
    "web-search",
    "search-provider",
    "dynamic-highlights"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geighlord007/dsh-web-search-exa-dynamic.git"
  },
  "bugs": {
    "url": "https://github.com/Geighlord007/dsh-web-search-exa-dynamic/issues"
  },
  "homepage": "https://github.com/Geighlord007/dsh-web-search-exa-dynamic#readme",
  "scripts": {
    "test": "node test/index.test.js",
    "live": "node test/live.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-web": "^0.1.5-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "engines": {
    "node": ">=18"
  }
}
